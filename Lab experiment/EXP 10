import numpy as np
import matplotlib.pyplot as plt
from sklearn.mixture import GaussianMixture

# Dataset
X = np.array([
    [1, 2],
    [1, 3],
    [2, 2],
    [2, 3],
    [8, 8],
    [9, 8],
    [8, 9],
    [9, 9]
])

# Create Gaussian Mixture Model
model = GaussianMixture(
    n_components=2,
    random_state=42
)

# Train using EM algorithm
model.fit(X)

# Predict clusters
labels = model.predict(X)

print("Cluster Labels:")
print(labels)

print("\nCluster Means:")
print(model.means_)

# Plot clusters
plt.scatter(
    X[:, 0],
    X[:, 1],
    c=labels
)

plt.xlabel("X")
plt.ylabel("Y")
plt.title("Expectation-Maximization Clustering")
plt.show()



